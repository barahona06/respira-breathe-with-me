# Respira configuration — copy this file to ".env" and fill in your key.
# Get your free API key at https://physiology.presagetech.com
# (Developer Portal → register → create an API key). No credit card needed.

# Your Presage SmartSpectra API key. NEVER commit the real .env file.
SMARTSPECTRA_API_KEY=pon-tu-clave-aqui

# Mode: mock | real | auto
#
#   mock — DEMO MODE with simulated data. This is the DEFAULT and the
#          mode to use for development and interface testing. It never
#          touches the SDK and spends ZERO credits.
#   real — LIVE measurement with the SmartSpectra SDK. Use it ONLY for
#          final verification and for recording the demo video.
#   auto — live when a valid key exists, demo otherwise. NOT recommended
#          during development: it burns credits on every run.
#
# ⚠ CREDIT BUDGET: the free trial includes 100 credits in total, and
# 1 credit = 30 seconds of live measurement — about 50 minutes, ever.
# Spend them like money: develop in mock mode, verify once, then record.
RESPIRA_MODE=mock
